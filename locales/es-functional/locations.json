    };

    const regiones = ["Kanto", "Johto", "Hoenn", "Sinnoh", "Unova", "Kalos", "Alola", "Galar"];

    // --- Traductor general optimizado ---
    function traducirTexto(texto) {
        if (!texto) return texto;

        // Claves ordenadas por longitud descendente para evitar conflictos
        const clavesOrdenadas = Object.keys(traduccionesLugares).sort((a, b) => b.length - a.length);

        for (const orig of clavesOrdenadas) {
            const trad = traduccionesLugares[orig];
            if (texto.includes(orig)) texto = texto.replaceAll(orig, trad);
        }

        return texto;
    }

    // --- Traducción de elementos DOM (eficiente) ---
    function traducirElemento(el) {
        if (!el) return;
        if (el.nodeType === 3) {
            const nuevoTexto = traducirTexto(el.nodeValue);
            if (nuevoTexto !== el.nodeValue) el.nodeValue = nuevoTexto;
        } else if (el.nodeType === 1) {
            ["title", "value", "placeholder", "alt"].forEach(attr => {
                const val = el.getAttribute(attr);
                if (val) {
                    const nuevoVal = traducirTexto(val);
                    if (nuevoVal !== val) el.setAttribute(attr, nuevoVal);
                }
            });
            el.childNodes.forEach(traducirElemento);
        }
    }

    // --- Traducción específica para knockout y nombres internos ---
    function traducirElementoKO(el) {
        const texto = el.textContent.trim();
        if (!texto) return;

        if (traduccionesLugares[texto]) {
            el.textContent = traduccionesLugares[texto];
            return;
        }

        for (const region of regiones) {
            const clave = `${region} ${texto}`;
            if (traduccionesLugares[clave]) {
                el.textContent = traduccionesLugares[clave];
                return;
            }
        }
    }

    // --- Traducción de botones dinámicos dentro de list-group ---
    function traducirBotonesDinamicos() {
        document.querySelectorAll('.list-group .btn-group button').forEach(btn => {
            const texto = btn.textContent.trim();
            if (!texto) return;

            // Traducción exacta o por región
            if (traduccionesLugares[texto]) {
                btn.textContent = traduccionesLugares[texto];
            } else {
                for (const region of regiones) {
                    const clave = `${region} ${texto}`;
                    if (traduccionesLugares[clave]) {
                        btn.textContent = traduccionesLugares[clave];
                        break;
                    }
                }
            }

            // Traducción de tooltip (title)
            const title = btn.getAttribute('title');
            if (title) {
                if (traduccionesLugares[title]) {
                    btn.setAttribute('title', traduccionesLugares[title]);
                } else {
                    for (const region of regiones) {
                        const clave = `${region} ${title}`;
                        if (traduccionesLugares[clave]) {
                            btn.setAttribute('title', traduccionesLugares[clave]);
                            break;
                        }
                    }
                }
            }
        });
    }

    // --- Traducción global de DOM ---
    function traducirTodoDOM() {
        document.querySelectorAll(
            'knockout[data-bind*="player.town.name"], knockout[data-bind*="Routes.getName"]'
        ).forEach(traducirElementoKO);

        traducirBotonesDinamicos();
    }

    // --- Observador único optimizado ---
    const observer = new MutationObserver(mutations => {
        for (const m of mutations) {
            for (const node of m.addedNodes) {
                if (node.nodeType === 1) {
                    if (node.textContent.trim().length > 1 || node.tagName === "KNOCKOUT") {
                        traducirElemento(node);
                        traducirElementoKO(node);
                        traducirBotonesDinamicos();
                    }
                } else if (node.nodeType === 3) {
                    traducirElemento(node);
                }
            }
        }
    });

    observer.observe(document.body, { childList: true, subtree: true });

    // --- Interceptar objetos internos ---
    function interceptarGame() {
        const game = unsafeWindow.Game;
        const Routes = unsafeWindow.Routes;
        if (!game || !Routes) return setTimeout(interceptarGame, 1000);

        const player = game.player;
        if (player && player.town) {
            const townKey = '_town';
            if (!player[townKey]) player[townKey] = player.town;
            Object.defineProperty(player, 'town', {
                get() {
                    const nombre = traduccionesLugares[this[townKey].name] || this[townKey].name;
                    return { ...this[townKey], name: nombre };
                },
                set(value) { this[townKey] = value; },
                configurable: true
            });
        }

        const originalGetName = Routes.getName;
        Routes.getName = function(route, region) {
            const nombreOriginal = originalGetName(route, region);
            if (!region) return traduccionesLugares[nombreOriginal] || nombreOriginal;
            const regionCapital = region.charAt(0).toUpperCase() + region.slice(1);
            const clave = `${regionCapital} ${nombreOriginal}`;
            return traduccionesLugares[clave] || traduccionesLugares[nombreOriginal] || nombreOriginal;
        };

        console.log("[PokéClicker-ES] ✅ Interceptores internos activos (v7.4 extendida)");
    }
    interceptarGame();

    // --- Tooltips dinámicos (menos frecuentes) ---
    function traducirTooltips() {
        document.querySelectorAll('[title]').forEach(el => {
            const texto = el.getAttribute('title').trim();
            if (traduccionesLugares[texto]) {
                el.setAttribute('title', traduccionesLugares[texto]);
            } else {
                for (const region of regiones) {
                    const clave = `${region} ${texto}`;
                    if (traduccionesLugares[clave]) {
                        el.setAttribute('title', traduccionesLugares[clave]);
                        break;
                    }
                }
            }
        });
    }

    // --- Intervalo de traducción ---
    setInterval(() => {
        traducirTodoDOM();
        traducirTooltips();
    }, 2000);

    // --- Traducción inicial ---
    traducirElemento(document.body);
    traducirTodoDOM();
    traducirTooltips();

    console.log("[PokéClicker-ES] 🌍 Traducción inicial completa (v7.4 extendida)");
})();