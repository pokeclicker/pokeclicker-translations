    // =============================
    // ⚙️ REEMPLAZO E INYECCIÓN
    // =============================

    // --- Función base de traducción ---
    function traducirQuestlines() {
        const elementos = document.querySelectorAll('[data-bind*="curQuestObject"]');
        elementos.forEach(el => {
            for (const [original, traducido] of Object.entries(questTranslations)) {
                if (el.textContent.includes(original)) {
                    el.textContent = el.textContent.replace(original, traducido);
                    console.log(`[PokéClicker-ES] 🧭 Quest traducida: ${original} → ${traducido}`);
                }
            }
        });
    }

    // --- Observador de DOM (por si se recarga el panel) ---
    const observer = new MutationObserver(() => traducirQuestlines());
    observer.observe(document.body, { childList: true, subtree: true });

    // --- Repetición cada cierto tiempo (por cambios Knockout) ---
    setInterval(traducirQuestlines, 1500);

    console.log("[PokéClicker-ES] 🔁 Traducción persistente de Questlines lista.");
})();